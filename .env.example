# Copy to .env and fill in. .env is gitignored and must stay that way.
# In production these are set as env vars in the TrueNAS Custom App wizard,
# never baked into the image.

# --- Public surface -------------------------------------------------------
# The hostname the public site is served on. Requests arriving with this Host
# are treated as public: /admin and /api/upload* return 404 for them.
PUBLIC_HOSTNAME=example.com

# Host-side port mapped to the container's 3000 in the app wizard.
# The container itself always listens on 3000.
APP_PORT=3000

# Peer address of the reverse proxy. X-Forwarded-For is trusted ONLY from here.
TRUSTED_PROXY_IP=127.0.0.1

# --- Storage --------------------------------------------------------------
# Container paths. The host paths behind them are set in the app wizard.
DATA_DIR=/config
ORIGINALS_DIR=/photos/originals
DERIVED_DIR=/photos/derived

# --- Admin auth -----------------------------------------------------------
# The password for the private admin side. Type whatever you want here; the
# app hashes it with argon2id at startup and never writes it down.
#
# Note the trade: a plaintext password here is readable by anyone who can open
# this app's settings in the NAS UI. That is fine for an app that is already
# unreachable from the internet. If you would rather it not be, leave this
# blank and set ADMIN_PASSWORD_HASH instead (npm run hash-password).
ADMIN_PASSWORD=

# Optional. An argon2id digest, used in place of ADMIN_PASSWORD when set.
ADMIN_PASSWORD_HASH=

# Optional. Signs the login cookie. Leave it blank and the app generates one on
# first boot and keeps it in DATA_DIR, so logins survive restarts and updates.
SESSION_SECRET=

# --- Home-coordinate guard ------------------------------------------------
# Photos taken within HOME_GUARD_KM of this point are flagged on ingest.
# Leave blank to disable the guard. NEVER commit real values, not even in a
# comment, a test fixture, or a default.
HOME_LAT=
HOME_LNG=
HOME_GUARD_KM=2

# --- The two people -------------------------------------------------------
# Display names only. The database stores user_a / user_b.
USER_A_NAME=A
USER_B_NAME=B

# --- Optional features ----------------------------------------------------
# Ticket-stub OCR. The app works without it; the feature is off when unset.
ANTHROPIC_API_KEY=
