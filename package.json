{
  "name": "ballpark-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "node scripts/spike-exif.mjs",
    "check": "bash scripts/check-no-secrets.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test \"lib/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "db:reset": "node scripts/migrate.ts && node scripts/seed.ts -- --demo",
    "hash-password": "node scripts/hash-password.ts",
    "check:coords": "node scripts/check-coords.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
